/* KLAB UI theme
   Teal + card styling with compact metrics for fixed-size Qt layouts.
*/

QMainWindow, QDialog {
    background-color: #084C61;
    color: #F2FBFF;
}

QWidget {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Aptos", "Tahoma", sans-serif;
}

/* Keep KLAB text readable; prefer width/spacing adjustments over font shrinking. */
QWidget#mainControls QGroupBox::title {
    font-weight: 600;
}

/* Dark-surface readability */
QMainWindow QLabel, QMainWindow QCheckBox, QMainWindow QRadioButton,
QDialog QLabel, QDialog QCheckBox, QDialog QRadioButton {
    color: #F2FBFF;
}

QMenuBar {
    background-color: rgba(2, 43, 58, 0.86);
    color: #F2FBFF;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
}

QMenuBar::item {
    background: transparent;
    padding: 2px 5px;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.16);
    color: #F2FBFF;
    border-radius: 5px;
}

QMenuBar::item:disabled {
    color: rgba(242, 251, 255, 0.46);
    background: transparent;
}

QMenu {
    background-color: rgba(255, 255, 255, 0.98);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
}

QMenu::item {
    padding: 3px 7px;
    color: #022B3A;
}

QMenu::item:selected {
    background-color: rgba(8, 76, 97, 0.16);
    color: #022B3A;
    border-radius: 5px;
}

QMenu::item:disabled {
    color: rgba(2, 43, 58, 0.44);
    background: transparent;
}

QMenu::item:selected:disabled {
    color: rgba(2, 43, 58, 0.44);
    background: rgba(8, 76, 97, 0.08);
}

QToolTip {
    background-color: rgba(255, 255, 255, 0.98);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.25);
}

QStatusBar {
    background-color: rgba(2, 43, 58, 0.90);
    color: #F2FBFF;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
}

QToolBar {
    background-color: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 7px;
    spacing: 2px;
    padding: 0px;
}

/* Card surfaces */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.95);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 2px;
    color: #022B3A;
    background-color: rgba(255, 255, 255, 0.98);
}

QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton {
    color: #022B3A;
}

QTabWidget::pane {
    background-color: rgba(255, 255, 255, 0.95);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 10px;
}

QTabBar::tab {
    background-color: rgba(255, 255, 255, 0.80);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 2px 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 0.98);
}

QTabBar::tab:disabled {
    color: rgba(2, 43, 58, 0.42);
    background-color: rgba(255, 255, 255, 0.56);
    border-color: rgba(2, 43, 58, 0.14);
}

QPushButton {
    background-color: rgba(255, 255, 255, 0.94);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 7px;
    padding: 1px 5px;
    min-height: 16px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 1.0);
}

QPushButton:pressed {
    background-color: rgba(8, 76, 97, 0.16);
}

QPushButton:disabled {
    color: rgba(2, 43, 58, 0.44);
    background-color: rgba(255, 255, 255, 0.62);
    border-color: rgba(2, 43, 58, 0.12);
}

/* Compact toolbutton style to keep "..." visible in 25x19 buttons */
QToolButton {
    background-color: rgba(255, 255, 255, 0.94);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 6px;
    padding: 0px 1px;
    min-width: 21px;
    min-height: 17px;
    margin: 0px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 1.0);
}

QToolButton:pressed {
    background-color: rgba(8, 76, 97, 0.16);
}

QToolButton:disabled {
    color: rgba(2, 43, 58, 0.40);
    background-color: rgba(255, 255, 255, 0.60);
    border-color: rgba(2, 43, 58, 0.12);
}

QLineEdit, QTextEdit, QPlainTextEdit,
QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background-color: rgba(255, 255, 255, 0.96);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 7px;
    padding: 0px 4px;
    selection-background-color: rgba(8, 76, 97, 0.30);
}

/* Keep native dropdown arrow, but modernize field styling for KLAB. */
QComboBox {
    background-color: rgba(255, 255, 255, 0.99);
    border: 1px solid rgba(2, 43, 58, 0.30);
    padding-left: 4px;
    padding-right: 5px;
}

QComboBox:hover {
    border-color: rgba(8, 76, 97, 0.55);
    background-color: rgba(255, 255, 255, 1.0);
}

QComboBox:focus {
    border-color: rgba(8, 76, 97, 0.70);
}

QComboBox::drop-down {
    width: 14px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url("gui/klab_dropdown_arrow_down.svg");
    width: 7px;
    height: 5px;
    margin-right: 4px;
}

QComboBox::down-arrow:disabled {
    image: url("gui/klab_dropdown_arrow_down.svg");
}

QComboBox:disabled {
    color: rgba(2, 43, 58, 0.48);
    background-color: rgba(255, 255, 255, 0.70);
    border-color: rgba(2, 43, 58, 0.18);
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QDateTimeEdit:disabled {
    color: rgba(2, 43, 58, 0.46);
    background-color: rgba(255, 255, 255, 0.72);
    border-color: rgba(2, 43, 58, 0.16);
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 14px;
    border: none;
    border-left: 1px solid rgba(2, 43, 58, 0.22);
    background-color: rgba(2, 43, 58, 0.84);
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-top: 1px solid rgba(242, 251, 255, 0.18);
    border-bottom-right-radius: 8px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgba(2, 43, 58, 0.96);
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: rgba(2, 43, 58, 1.0);
}

QSpinBox::up-button:disabled, QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::down-button:disabled {
    background-color: rgba(2, 43, 58, 0.30);
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("gui/klab_spin_arrow_up.svg");
    width: 7px;
    height: 5px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("gui/klab_dropdown_arrow_down.svg");
    width: 7px;
    height: 5px;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url("gui/klab_spin_arrow_up.svg");
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url("gui/klab_dropdown_arrow_down.svg");
}

QCheckBox, QRadioButton {
    spacing: 5px;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: rgba(2, 43, 58, 0.44);
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 13px;
    height: 13px;
}

QCheckBox::indicator {
    border: 1px solid rgba(2, 43, 58, 0.34);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.96);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: rgba(2, 43, 58, 0.16);
    background-color: rgba(255, 255, 255, 0.55);
}

QCheckBox::indicator:checked {
    background: rgba(8, 76, 97, 0.84);
}

QRadioButton::indicator {
    border: 1px solid rgba(2, 43, 58, 0.34);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.96);
}

QRadioButton::indicator:checked {
    background: rgba(8, 76, 97, 0.84);
}

QTableView, QTreeView, QListView, QListWidget, QTableWidget {
    background-color: rgba(255, 255, 255, 0.96);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 8px;
    alternate-background-color: rgba(8, 76, 97, 0.06);
    gridline-color: rgba(2, 43, 58, 0.14);
}

QHeaderView::section {
    background-color: rgba(8, 76, 97, 0.16);
    color: #022B3A;
    border: 1px solid rgba(2, 43, 58, 0.18);
    padding: 1px 4px;
}

/* Compact-on-demand variants used by the KLAB polisher for fixed geometries.
   These only tighten spacing; they do not reduce font size. */
QGroupBox[klabCompact="true"]::title {
    left: 7px;
    padding: 0 1px;
}

QLabel[klabCompact="true"],
QCheckBox[klabCompact="true"],
QRadioButton[klabCompact="true"],
QPushButton[klabCompact="true"],
QToolButton[klabCompact="true"],
QComboBox[klabCompact="true"],
QSpinBox[klabCompact="true"],
QDoubleSpinBox[klabCompact="true"],
QDateTimeEdit[klabCompact="true"],
QLineEdit[klabCompact="true"],
QTabBar[klabCompact="true"] {
}

QPushButton[klabCompact="true"] {
    padding: 0px 4px;
    min-height: 15px;
}

QToolButton[klabCompact="true"] {
    min-width: 20px;
    min-height: 16px;
}

QComboBox[klabCompact="true"],
QSpinBox[klabCompact="true"],
QDoubleSpinBox[klabCompact="true"],
QDateTimeEdit[klabCompact="true"],
QLineEdit[klabCompact="true"] {
    padding: 0px 3px;
}

QComboBox[klabCompact="true"]::drop-down {
    width: 13px;
}

QSpinBox[klabCompact="true"]::up-button,
QSpinBox[klabCompact="true"]::down-button,
QDoubleSpinBox[klabCompact="true"]::up-button,
QDoubleSpinBox[klabCompact="true"]::down-button {
    width: 13px;
}

QTabBar[klabCompact="true"]::tab {
    padding: 1px 5px;
}

QProgressBar {
    background-color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(2, 43, 58, 0.22);
    border-radius: 8px;
    color: #022B3A;
    text-align: center;
}

QProgressBar::chunk {
    background-color: rgba(8, 76, 97, 0.86);
    border-radius: 7px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(2, 43, 58, 0.16);
    border-radius: 7px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: rgba(8, 76, 97, 0.45);
    border-radius: 6px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}
